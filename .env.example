# Browser-public Firebase Auth config (supplied at Vite BUILD time)
# Project and database IDs are public identifiers, not credentials. Preserve existing Web App.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=elite-implement-hxnr0
VITE_FIREBASE_APP_ID=
VITE_ENABLE_DEMO=false

# Cloud Run server-side environment / secret manager
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FIREBASE_PROJECT_ID=elite-implement-hxnr0
# Required: exact existing database ID shown in Firebase Firestore selector (never assume default)
FIRESTORE_DATABASE_ID=ai-studio-bunyan-f5403500-fee9-4eed-bc88-c5a71cbff964
OWNER_UID=
PORT=8080
